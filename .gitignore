# ── 빌드 도구 ───────────────────────────────────────────
node_modules/

# wrangler 가 배포할 때 만드는 임시 산출물 (원본이 아닙니다)
.wrangler/

# ── 비밀 값 ─────────────────────────────────────────────
# 이 저장소는 공개입니다. 아래 항목은 절대 커밋되지 않아야 합니다.
secret/
*.pem
*.key
*.p12
*.pfx
.env
.env.*

# 배포 설정 (계정 ID·버킷 이름이 들어갑니다)
deploy/config.sh

# ── 빌드 산출물 ─────────────────────────────────────────
# /writing/ 은 content/writing/*.md 에서 만들어집니다. 원본이 아닙니다.
# 앞의 슬래시가 중요합니다. 없으면 content/writing/ 까지 함께 무시돼서
# 글 원본이 커밋되지 않습니다.
/_site/
/writing/

