# config.sh 는 .gitignore 에 들어 있습니다. 저장소에 올라가지 않습니다.

# Amplify 앱 ID
#   aws amplify list-apps --region ap-northeast-2 \
#     --query 'apps[].{name:name,id:appId}' --output table
export AMPLIFY_APP_ID="d2szwegb9si7cs"

# 배포할 브랜치
export AMPLIFY_BRANCH="main"

export AWS_REGION="ap-northeast-2"

